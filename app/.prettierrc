{
	"useTabs": true,
	"tabWidth": 4,
	"singleQuote": true,
	"printWidth": 100,
	"trailingComma": "es5",
	"semi": true,
	"proseWrap": "always",
	"plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-svelte"],
	"tailwindStylesheet": "./src/app.css",
	"tailwindFunctions": ["clsx", "cva"],
	"tailwindPreserveWhitespace": true,
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	]
}
